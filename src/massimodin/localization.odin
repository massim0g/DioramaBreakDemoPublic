#+feature dynamic-literals
package massimodin //@nested-tags:engine/localization

LOCALES_MAX :: 20 //maximum number of locales that can be loaded at once

LocaleID :: distinct int

locale_display_name :: proc(id:LocaleID) -> string{
	code := dialogue.locales_loaded[id]
	out,ok := LOCALE_CODE_DISPLAY_NAMES[string_lower(code, context.temp_allocator)]
	if !ok do return code 
	return out
}

